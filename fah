localplayer:Toggle({
  Flag = "WSEnableToggle",
  Title = "Enable",
  Value = false,
  Callback = function(value)
        if value then
            local RunService = game:GetService("RunService")
            local hum = game.Players.LocalPlayer.Character.Humanoid
            getgenv().loopWalkSpeed = RunService.RenderStepped:Connect(function()
               hum.WalkSpeed = 16 + getgenv().WSslider
          end)
        else
            getgenv().loopWalkSpeed:Disconnect()
            getgenv().loopWalkSpeed = nil
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
  end,
})

localplayer:Toggle({
  Flag = "FBToggle",
  Title = "Fullbright",
  Value = false,
  Callback = function(value)
    getgenv().FB = value
    if value then
     task.spawn(function()
      local Lighting = game:GetService("Lighting")
      -- Save original settings
      local originalBrightness = Lighting.Brightness
      local originalAmbient = Lighting.Ambient
      local originalOutdoorAmbient = Lighting.OutdoorAmbient
      local originalFogEnd = Lighting.FogEnd
      local originalFogStart = Lighting.FogStart
      local originalClockTime = Lighting.ClockTime
      local originalGlobalShadows = Lighting.GlobalShadows

      while getgenv().FB do
       -- Apply fullbright
       Lighting.Brightness = 2
       Lighting.Ambient = Color3.fromRGB(178, 178, 178)
       Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
       Lighting.FogEnd = 100000
       Lighting.FogStart = 0
       Lighting.ClockTime = 12
       Lighting.GlobalShadows = false
       
       -- Remove atmosphere and bloom effects
       for _, effect in ipairs(Lighting:GetChildren()) do
           if effect:IsA("Atmosphere") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") then
               effect.Enabled = false
           end
       end
        task.wait(0.1)
      end
      
      Lighting.Brightness = originalBrightness
      Lighting.Ambient = originalAmbient
      Lighting.OutdoorAmbient = originalOutdoorAmbient
      Lighting.FogEnd = originalFogEnd
      Lighting.FogStart = originalFogStart
      Lighting.ClockTime = originalClockTime
      Lighting.GlobalShadows = originalGlobalShadows
      
      for _, effect in ipairs(Lighting:GetChildren()) do
          if effect:IsA("Atmosphere") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") then
              effect.Enabled = true
          end
      end
     end)
    end
   end,
})

