local EntDescendantChecker
ESPSection:Toggle({
  Flag = "EntityESPToggle",
  Title = "Entity ESP",
  Value = false,
  Callback = function(value)
    if value then
		local function highlight(Ent)
			if specialEnt[Ent.Name] then
				ESPLibrary:AddESP({
					Object = Ent,
					Text = EntityNames[Ent.Name],
					Color = Color3.fromRGB(255, 0, 0),
				})
			else
				local Hhum = Instance.new("Humanoid")
				Hhum.Name = "Hhum"
				Hhum.Parent = Ent

				repeat
					task.wait()
				until Ent:FindFirstChildOfClass("Part")

				local Hpart = Ent:FindFirstChildOfClass("Part")
				Hpart.Transparency = 0.99

				ESPLibrary:AddESP({
					Object = Hpart,
					Text = EntityNames[Ent.Name],
					Color = Color3.fromRGB(255, 0, 0),
				})
			end
		end

		for _, Ent in pairs(game.Workspace:GetDescendants()) do
              if Ent and EntityNames[Ent.Name] then
                  highlight(Ent)
              end
        end

		EntDescendantChecker = game.Workspace.DescendantAdded:Connect(function(Ent)
              if Ent and EntityNames[Ent.Name] then
                  highlight(Ent)
              end
        end)
	else
		if EntDescendantChecker then
			EntDescendantChecker:Disconnect()
			EntDescendantChecker = nil
		end

		for _, Ent in pairs(game.Workspace:GetDescendants()) do
              if Ent and EntityNames[Ent.Name] then
                  if specialEnt[Ent.Name] then
					 ESPLibrary:RemoveESP(Ent)
				  else
					 local Hhum = Ent:FindFirstChild("Hhum")
					 local Hpart = Ent:FindFirstChildOfClass("Part")
	
					 if Hhum then
						Hhum:Destroy()
					 end
	
					 if Hpart then
						ESPLibrary:RemoveESP(Hpart)
						Hpart.Transparency = 1
					 end
				  end
              end
        end
	end
  end,
})

