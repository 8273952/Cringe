-- toggles and stuff (General)

getgenv().WalkSpeedValue = 35
CharacterSection:Slider({
  Flag = "WalkspeedValueSlider",
  Title = "Walkspeed",
  Step = 1,
  Value = {
    Min = 2,
    Max = 100,
    Default = 35,
  },
  Callback = function(value)
      getgenv().WalkSpeedValue = value
  end,
})

CharacterSection:Toggle({
  Flag = "EnableWalkspeedToggle",
  Title = "Enable Walkspeed",
  Value = false,
  Callback = function(value)
      getgenv().EnabledWalkspeedToggle = value
      if getgenv().EnabledWalkspeedToggle then
          task.spawn(function()
              while getgenv().EnabledWalkspeedToggle do
                  Hum.WalkSpeed = getgenv().WalkSpeedValue
                  task.wait(0.05)
              end
          end)
      else
          Hum.WalkSpeed = 15
      end
  end,
})

