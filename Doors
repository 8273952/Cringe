-- toggles and stuff (General Tab)

getgenv().WalkSpeedValue = 35
CharacterSection:Slider({
  Flag = "WalkspeedValueSlider",
  Title = "Walkspeed",
  Step = 1,
  Value = {
    Min = 2,
    Max = 100,
    Default = 35,
  },
  Callback = function(value)
      getgenv().WalkSpeedValue = value
  end,
})

CharacterSection:Toggle({
  Flag = "EnableWalkspeedToggle",
  Title = "Enable Walkspeed",
  Value = false,
  Callback = function(value)
      getgenv().EnabledWalkspeedToggle = value
      if getgenv().EnabledWalkspeedToggle then
          task.spawn(function()
              while getgenv().EnabledWalkspeedToggle do
                  if Hum then
                      Hum.WalkSpeed = getgenv().WalkSpeedValue
                  end
                  RemotesFolder.Crouch:FireServer(true, true)
                  task.wait(0.05)
              end
          end)
      else
          if Hum then
              Hum.WalkSpeed = 15
          end
          RemotesFolder.Crouch:FireServer(false, false)
      end
  end,
})

local oldPhysics = Hrp.CustomPhysicalProperties
CharacterSection:Toggle({
  Flag = "NoAccelerationToggle",
  Title = "No acceleration",
  Value = false,
  Callback = function(value)
    getgenv().NoAccelToggleValue = value
    if getgenv().NoAccelToggleValue then
        task.spawn(function()
            while getgenv().NoAccelToggleValue do
                if Hrp then
                    Hrp.CustomPhysicalProperties = PhysicalProperties.new(10, 0.7, 0)
                end
                task.wait(0.05)
            end
        end)
    else
        if Hrp then
            Hrp.CustomPhysicalProperties = oldPhysics
        end
    end
  end,
})

local CanJumpValueChanged
CharacterSection:Toggle({
  Flag = "EnableJumpToggle",
  Title = "Enable Jump",
  Value = false,
  Callback = function(value)
    if value then
        if Chr:GetAttribute("CanJump") then
            Chr:SetAttribute("CanJump", true)
        else
            Chr:SetAttribute("CanJump", true)
        end

        CanJumpValueChanged = Chr:GetAttributeChangedSignal("CanJump"):Connect(function()
            if Chr:GetAttribute("CanJump") ~= true then
                Chr:SetAttribute("CanJump", true)    
            end
        end)
    else
        if CanJumpValueChanged then
            CanJumpValueChanged:Disconnect()
            CanJumpValueChanged = nil
        end

        if Chr:GetAttribute("CanJump") then
            Chr:SetAttribute("CanJump", false)
        end
    end
  end,
})

-- Toggles and Stuff (Visuals Tab) --

local DoorDescendantChecker
ESPSection:Toggle({
  Flag = "DoorESPToggle",
  Title = "Door ESP",
  Value = false,
  Callback = function(value)
    if value then
        local function highlight(Door)
        	if not Door.Parent:FindFirstChild("hModel") then
        		local Model = Instance.new("Model")
        		Model.Name = "hModel"
        		Model.Parent = Door.Parent
        
        		local humanoid = Instance.new("Humanoid")
        		humanoid.Name = "hHum"
        		humanoid.Parent = Model
        
        		local hPart = Instance.new("Part")
        		hPart.Size = Door.Size
        		hPart.CFrame = Door.CFrame
        		hPart.Transparency = 0.99
        		hPart.CanCollide = false
        		hPart.Name = "hPart"
        		hPart.Parent = Model
        
        		local weld = Instance.new("Weld")
                weld.Part0 = Door
                weld.Part1 = hPart
                weld.C0 = CFrame.new(0, 0, 0)
                weld.Parent = hPart
        
        		local RoomID = Door.Parent:GetAttribute("RoomID")
        		ESPLibrary:AddESP({
        			Object = hPart,
        			Text = Door.Parent.Name .. "[" .. RoomID .. "]",
        			Color = Color3.fromRGB(0, 255, 255)
        		})
        	end
        end

        for _, Door in ipairs(Rooms:GetDescendants()) do
			if Door.Name == "Door" and Door.Parent.Name == "Door" then
				highlight(Door)
			end
		end

        DoorDescendantChecker = Rooms.DescendantAdded:Connect(function(Door)
			if Door.Name == "Door" and Door.Parent.Name == "Door" then
				highlight(Door)
			end
		end)
    else
        if DoorDescendantChecker then
			DoorDescendantChecker:Disconnect()
			DoorDescendantChecker = nil
		end

        for _, Door in ipairs(Rooms:GetDescendants()) do
			if Door.Name == "Door" and Door.Parent.Name == "Door" then
				local Model = Door.Parent:FindFirstChild("hModel")

				if Model then
					local hPart = Model:FindFirstChild("hPart")
					if hPart then
						ESPLibrary:RemoveESP(hPart)
					end
				end
				if Model then
					Model:Destroy()
				end
			end
		end
    end
  end,
})
