local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "LOL",
    Icon = "star",
    Theme = "Dark",
    Folder = "LOL",
})

local Tab = Window:Tab({
    Title = "Main",
    Icon = "home",
})

-- Toggle
Tab:Toggle({
    Title = "Evidence ESP",
    Value = false,
    Callback = function(value)
        if value then
            local function addhighlight(Evidence)
                if not Evidence:FindFirstChildOfClass("Highlight") and not Evidence:FindFirstChildOfClass("Humanoid") then
                    local hHum = Instance.new("Humanoid")
                    local highlight = Instance.new("Highlight")
                    highlight.Parent = Evidence
                    hHum.Parent = Evidence
                    Evidence.Transparency = 0.99
                    print("dada")
                end
            end

            for _, Evidence in ipairs(game.Workspace:GetDescendants()) do
                if Evidence.Name == "GhostOrb" or Evidence.Parent == "Handprints" then
                    addhighlight(Evidence)
                end
            end
        else
            for _, Evidence in ipairs(game.Workspace:GetDescendants()) do
                if Evidence:FindFirstChildOfClass("Highlight") and Evidence:FindFirstChildOfClass("Humanoid") and Evidence.Name == "GhostOrb" or Evidence.Parent == "Handprints" then
                    Evidence:FindFirstChildOfClass("Highlight"):Destroy()
                    Evidence:FindFirstChildOfClass("Humanoid"):Destroy()
                    Evidence.Transparency = 1
                    print("jewjej")
                end
            end
        end
    end,
})

